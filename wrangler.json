{
	"name": "astro-blog-starter-template",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./dist/_worker.js/index.js",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "qblog.qwarts.my.id",
			"custom_domain": true
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false
		}
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "my-binding",
			"database_name": "qblog-db",
			"database_id": "bda4401a-4baf-48e6-9ad9-a63e253ff2a9"
		}
	]
}