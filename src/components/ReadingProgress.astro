---
// Reading Progress Indicator Bar
---

<div id="reading-progress-container" class="reading-progress-bar" aria-hidden="true">
	<div id="reading-progress-fill" class="progress-fill"></div>
</div>

<script>
	function updateReadingProgress() {
		const fill = document.getElementById('reading-progress-fill');
		if (!fill) return;

		const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
		const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
		const scrolled = height > 0 ? (winScroll / height) * 100 : 0;

		fill.style.width = Math.min(100, Math.max(0, scrolled)) + '%';
	}

	window.addEventListener('scroll', updateReadingProgress, { passive: true });
	window.addEventListener('resize', updateReadingProgress);
	updateReadingProgress();
</script>

<style>
	.reading-progress-bar {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 3px;
		z-index: 100;
		background: transparent;
		pointer-events: none;
	}

	.progress-fill {
		height: 100%;
		width: 0%;
		background: linear-gradient(90deg, #6366f1 0%, #a855f7 50%, #06b6d4 100%);
		box-shadow: 0 0 10px rgba(99, 102, 241, 0.7);
		transition: width 0.05s linear;
	}
</style>
