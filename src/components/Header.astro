---
import HeaderLink from './HeaderLink.astro';
import { AUTHOR_NAME, SOCIAL_LINKS } from '../consts';
---

<header class="site-header">
	<div class="container header-inner">
		<div class="header-brand">
			<a href="/" class="brand-link">
				<span class="brand-dot"></span>
				<span class="brand-title">qblog</span>
				<span class="brand-author">/{AUTHOR_NAME}</span>
			</a>
		</div>

		<nav class="header-nav" aria-label="Main Navigation">
			<HeaderLink href="/" class="nav-item">Home</HeaderLink>
			<HeaderLink href="/blog" class="nav-item">Blog</HeaderLink>
			<HeaderLink href="/series" class="nav-item">Series</HeaderLink>
			<HeaderLink href="/projects" class="nav-item">Projects</HeaderLink>
			<HeaderLink href="/knowledge" class="nav-item">Knowledge</HeaderLink>
			<HeaderLink href="/about" class="nav-item">About</HeaderLink>
			<HeaderLink href="/cv" class="nav-item nav-cv">CV / Resume</HeaderLink>
		</nav>

		<div class="header-actions">
			<a href="/search" class="icon-btn" title="Search Articles" aria-label="Search">
				<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="8"></circle>
					<path d="m21 21-4.3-4.3"></path>
				</svg>
			</a>
			<a
				href={SOCIAL_LINKS.github}
				target="_blank"
				rel="noopener noreferrer"
				class="icon-btn"
				title="GitHub Profile"
				aria-label="GitHub Profile"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
				</svg>
			</a>
			<a
				href="/rss.xml"
				class="icon-btn"
				title="RSS Feed"
				aria-label="RSS Feed"
			>
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 11a9 9 0 0 1 9 9"></path>
					<path d="M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1"></circle>
				</svg>
			</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		width: 100%;
		background: rgba(10, 13, 20, 0.82);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		border-bottom: 1px solid var(--border-subtle);
		transition: border-color 0.2s ease;
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 4rem;
	}

	.header-brand {
		display: flex;
		align-items: center;
	}

	.brand-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		text-decoration: none;
	}

	.brand-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #10b981;
		box-shadow: 0 0 10px #10b981;
		animation: pulse-dot 2.5s infinite;
	}

	@keyframes pulse-dot {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.5; transform: scale(0.85); }
	}

	.brand-title {
		font-family: "Plus Jakarta Sans", sans-serif;
		font-size: 1.25rem;
		font-weight: 800;
		color: #ffffff;
		letter-spacing: -0.03em;
	}

	.brand-author {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.85rem;
		color: var(--primary-light);
		font-weight: 500;
	}

	.header-nav {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.nav-item {
		padding: 0.45rem 0.85rem;
		border-radius: var(--radius-sm);
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--text-secondary);
		transition: var(--transition-smooth);
	}

	.nav-item:hover {
		color: var(--text-primary);
		background: rgba(255, 255, 255, 0.05);
	}

	.nav-item.active {
		color: #ffffff;
		background: rgba(99, 102, 241, 0.15);
		border: 1px solid rgba(99, 102, 241, 0.3);
		text-decoration: none;
	}

	.nav-cv {
		border: 1px solid rgba(16, 185, 129, 0.35);
		background: rgba(16, 185, 129, 0.08);
		color: #6ee7b7;
	}

	.nav-cv:hover {
		background: rgba(16, 185, 129, 0.2);
		color: #ffffff;
		border-color: #34d399;
	}

	.header-actions {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.icon-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		border-radius: var(--radius-sm);
		color: var(--text-muted);
		transition: var(--transition-smooth);
		border: 1px solid transparent;
	}

	.icon-btn:hover {
		color: var(--text-primary);
		background: rgba(255, 255, 255, 0.06);
		border-color: var(--border-subtle);
	}

	@media (max-width: 680px) {
		.brand-author {
			display: none;
		}
		.header-nav {
			gap: 0.2rem;
		}
		.nav-item {
			padding: 0.35rem 0.5rem;
			font-size: 0.8rem;
		}
		.header-actions {
			display: none;
		}
	}
</style>
