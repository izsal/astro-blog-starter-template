---
import { AUTHOR_NAME, SOCIAL_LINKS, SITE_TITLE } from '../consts';
const today = new Date();
---

<footer class="site-footer">
	<div class="container footer-inner">
		<div class="footer-top">
			<div class="footer-brand-col">
				<div class="footer-logo">
					<span class="logo-dot"></span>
					<span class="logo-text">qblog</span>
				</div>
				<p class="footer-tagline">
					Personal Knowledge Hub & Portfolio by <span class="author-highlight">{AUTHOR_NAME}</span>.
					Membangun personal branding, dokumentasi teknis, dan arsitektur edge computing.
				</p>
				<div class="edge-badge">
					<span class="badge-icon">⚡</span>
					<span>Powered by Astro 5 & Cloudflare D1 (SQLite)</span>
				</div>
			</div>

			<div class="footer-links-grid">
				<div class="links-col">
					<h4 class="col-title">Navigation</h4>
					<ul class="footer-nav-list">
						<li><a href="/">Home</a></li>
						<li><a href="/blog">Articles & Guides</a></li>
						<li><a href="/projects">Projects Showcase</a></li>
						<li><a href="/knowledge">Knowledge Hub (TIL)</a></li>
						<li><a href="/about">About {AUTHOR_NAME}</a></li>
					</ul>
				</div>

				<div class="links-col">
					<h4 class="col-title">Clusters</h4>
					<ul class="footer-nav-list">
						<li><a href="/blog?tag=Astro">Astro & SSR</a></li>
						<li><a href="/blog?tag=Cloudflare">Cloudflare & D1</a></li>
						<li><a href="/blog?tag=TypeScript">TypeScript</a></li>
						<li><a href="/blog?tag=Docker">Docker & Linux</a></li>
					</ul>
				</div>

				<div class="links-col">
					<h4 class="col-title">Connect</h4>
					<ul class="footer-nav-list">
						<li><a href={SOCIAL_LINKS.github} target="_blank" rel="noopener">GitHub</a></li>
						<li><a href={SOCIAL_LINKS.twitter} target="_blank" rel="noopener">Twitter / X</a></li>
						<li><a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener">LinkedIn</a></li>
						<li><a href="/rss.xml">RSS Feed</a></li>
					</ul>
				</div>
			</div>
		</div>

		<div class="footer-bottom">
			<p>&copy; {today.getFullYear()} {AUTHOR_NAME}. All rights reserved.</p>
			<p class="domain-text">qblog.qwarts.my.id</p>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		background: #080b12;
		border-top: 1px solid var(--border-subtle);
		padding: 4rem 0 2rem;
		font-size: 0.9rem;
	}

	.footer-top {
		display: grid;
		grid-template-columns: 1.5fr 2fr;
		gap: 3rem;
		margin-bottom: 3.5rem;
	}

	.footer-logo {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.8rem;
	}

	.logo-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #10b981;
	}

	.logo-text {
		font-family: "Plus Jakarta Sans", sans-serif;
		font-weight: 800;
		font-size: 1.3rem;
		color: #ffffff;
	}

	.footer-tagline {
		color: var(--text-secondary);
		line-height: 1.6;
		max-width: 380px;
		margin-bottom: 1.25rem;
	}

	.author-highlight {
		color: var(--primary-light);
		font-weight: 600;
	}

	.edge-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.35rem 0.75rem;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-sm);
		font-size: 0.78rem;
		color: #94a3b8;
		font-family: "JetBrains Mono", monospace;
	}

	.footer-links-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}

	.col-title {
		font-size: 0.95rem;
		font-weight: 700;
		color: #ffffff;
		margin-bottom: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.footer-nav-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.footer-nav-list a {
		color: var(--text-muted);
		transition: var(--transition-smooth);
	}

	.footer-nav-list a:hover {
		color: var(--primary-light);
		padding-left: 3px;
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 2rem;
		border-top: 1px solid var(--border-subtle);
		color: var(--text-muted);
		font-size: 0.82rem;
	}

	.domain-text {
		font-family: "JetBrains Mono", monospace;
	}

	@media (max-width: 820px) {
		.footer-top {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.footer-links-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.footer-bottom {
			flex-direction: column;
			gap: 0.75rem;
			text-align: center;
		}
	}
</style>
