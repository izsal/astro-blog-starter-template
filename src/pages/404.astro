---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, AUTHOR_NAME } from '../consts';

export const prerender = true;
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead
			title={`404: Halaman Tidak Ditemukan — ${SITE_TITLE}`}
			description="Halaman yang Anda tuju tidak ditemukan di qblog. Jelajahi artikel, series, atau portofolio proyek."
		/>
	</head>
	<body class="not-found-body">
		<Header />

		<main class="not-found-main section">
			<div class="container not-found-container">
				<!-- Brand Header Monogram & Status Pulse -->
				<div class="brand-badge-wrapper">
					<div class="brand-badge">
						<span class="brand-dot"></span>
						<span class="brand-title">qblog</span>
						<span class="brand-author">/{AUTHOR_NAME}</span>
						<span class="brand-status-tag">404 ROUTE_NOT_FOUND</span>
					</div>
				</div>

				<!-- Visual Big 404 Hero with Brand Identity -->
				<div class="not-found-hero">
					<div class="glitch-wrapper">
						<div class="cyber-badge">SYSTEM DIAGNOSTIC // HTTP 404</div>
						<h1 class="big-code">404</h1>
						<div class="glitch-glow"></div>
					</div>

					<h2 class="hero-heading">
						Halaman Tidak Ditemukan di <span class="gradient-text">qblog</span>
					</h2>
					<p class="hero-lead">
						Tautan yang kamu tuju mungkin telah dipindahkan, berganti slug, atau masih dalam antrean penulisan di Content Hub qblog.
					</p>
				</div>

				<!-- Terminal Diagnostic Card -->
				<div class="terminal-card">
					<div class="terminal-header">
						<div class="terminal-buttons">
							<span class="t-btn t-close"></span>
							<span class="t-btn t-min"></span>
							<span class="t-btn t-max"></span>
						</div>
						<div class="terminal-title">bash — qblog-edge ~ diagnostic</div>
						<div class="terminal-empty"></div>
					</div>
					<div class="terminal-body">
						<div class="t-line">
							<span class="t-prompt">$</span>
							<span class="t-cmd">curl -I https://qblog.qwarts.my.id<span id="current-url"></span></span>
						</div>
						<div class="t-response">
							<p><span class="t-cyan">&gt; HTTP/2 404 Not Found</span></p>
							<p><span class="t-muted">&gt; server:</span> cloudflare-worker (qblog-d1-edge)</p>
							<p><span class="t-muted">&gt; status:</span> <span class="t-red">PAGE_OR_RESOURCE_MISSING</span></p>
							<p><span class="t-muted">&gt; suggestion:</span> Cek URL kembali atau gunakan pencarian artikel di bawah</p>
						</div>
					</div>
				</div>

				<!-- Search Bar Recovery -->
				<div class="search-recovery-box">
					<form action="/search" method="GET" class="recovery-search-form">
						<svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="11" cy="11" r="8"></circle>
							<path d="m21 21-4.3-4.3"></path>
						</svg>
						<input
							type="text"
							name="q"
							placeholder="Cari artikel, topik Cloudflare, Astro, Docker, atau proyek..."
							class="recovery-search-input"
							autocomplete="off"
						/>
						<button type="submit" class="btn btn-primary recovery-search-btn">
							<span>Cari Artikel</span>
						</button>
					</form>
				</div>

				<!-- Helpful Navigation Cards -->
				<div class="quick-nav-section">
					<h3 class="quick-nav-title">Rute Populer yang Bisa Kamu Kunjungi</h3>
					<div class="quick-nav-grid">
						<a href="/" class="quick-card">
							<div class="card-icon">🏠</div>
							<div class="card-text">
								<h4>Beranda</h4>
								<p>Halaman utama qblog & ikhtisar terbaru</p>
							</div>
							<span class="card-arrow">&rarr;</span>
						</a>

						<a href="/blog" class="quick-card">
							<div class="card-icon">📝</div>
							<div class="card-text">
								<h4>Semua Artikel</h4>
								<p>Tutorial, insight teknis & dokumentasi dev</p>
							</div>
							<span class="card-arrow">&rarr;</span>
						</a>

						<a href="/series" class="quick-card">
							<div class="card-icon">📚</div>
							<div class="card-text">
								<h4>Content Series</h4>
								<p>Kurikulum belajar bertahap & cluster topik</p>
							</div>
							<span class="card-arrow">&rarr;</span>
						</a>

						<a href="/projects" class="quick-card">
							<div class="card-icon">🚀</div>
							<div class="card-text">
								<h4>Showcase Proyek</h4>
								<p>Portofolio aplikasi & implementasi sistem</p>
							</div>
							<span class="card-arrow">&rarr;</span>
						</a>

						<a href="/cv" class="quick-card">
							<div class="card-icon">📄</div>
							<div class="card-text">
								<h4>Curriculum Vitae</h4>
								<p>Resume profesional {AUTHOR_NAME}</p>
							</div>
							<span class="card-arrow">&rarr;</span>
						</a>

						<a href="/explore" class="quick-card">
							<div class="card-icon">🧠</div>
							<div class="card-text">
								<h4>Knowledge Map</h4>
								<p>Eksplorasi graf arsitektur konten</p>
							</div>
							<span class="card-arrow">&rarr;</span>
						</a>
					</div>
				</div>

				<!-- Return Button -->
				<div class="return-action">
					<a href="/" class="btn btn-secondary back-home-btn">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="m15 18-6-6 6-6"></path>
						</svg>
						<span>Kembali ke Beranda qblog</span>
					</a>
				</div>
			</div>
		</main>

		<Footer />

		<script>
			// Display current missing pathname in terminal simulation
			if (typeof window !== 'undefined') {
				const currentUrlSpan = document.getElementById('current-url');
				if (currentUrlSpan) {
					currentUrlSpan.textContent = window.location.pathname || '/halaman-tidak-ditemukan';
				}
			}
		</script>
	</body>
</html>

<style>
	.not-found-body {
		background-color: var(--bg-primary);
		color: var(--text-primary);
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.not-found-main {
		flex: 1;
		display: flex;
		align-items: center;
		padding: 4rem 1.5rem;
	}

	.not-found-container {
		max-width: 860px;
		margin: 0 auto;
		text-align: center;
	}

	/* Brand Badge from Header */
	.brand-badge-wrapper {
		display: flex;
		justify-content: center;
		margin-bottom: 2rem;
	}

	.brand-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.5rem 1.15rem;
		background: rgba(15, 23, 42, 0.75);
		border: 1px solid rgba(56, 189, 248, 0.25);
		border-radius: 9999px;
		backdrop-filter: blur(12px);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
	}

	.brand-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #10b981;
		box-shadow: 0 0 12px #10b981;
		animation: pulse-dot 2.5s infinite;
	}

	@keyframes pulse-dot {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.45; transform: scale(0.85); }
	}

	.brand-title {
		font-family: "Plus Jakarta Sans", sans-serif;
		font-size: 1.15rem;
		font-weight: 800;
		color: #ffffff;
		letter-spacing: -0.03em;
	}

	.brand-author {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.85rem;
		color: #38bdf8;
		font-weight: 500;
	}

	.brand-status-tag {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.72rem;
		color: #ef4444;
		background: rgba(239, 68, 68, 0.12);
		border: 1px solid rgba(239, 68, 68, 0.3);
		padding: 0.2rem 0.5rem;
		border-radius: 6px;
		letter-spacing: 0.04em;
		font-weight: 600;
	}

	/* Hero Display */
	.not-found-hero {
		margin-bottom: 2.5rem;
	}

	.glitch-wrapper {
		position: relative;
		display: inline-block;
		margin-bottom: 1rem;
	}

	.cyber-badge {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.75rem;
		color: #38bdf8;
		letter-spacing: 0.15em;
		margin-bottom: 0.5rem;
		opacity: 0.85;
	}

	.big-code {
		font-family: "Plus Jakarta Sans", sans-serif;
		font-size: clamp(6rem, 16vw, 9.5rem);
		font-weight: 900;
		line-height: 1;
		margin: 0;
		background: linear-gradient(135deg, #ffffff 20%, #38bdf8 60%, #6366f1 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		letter-spacing: -0.05em;
		text-shadow: 0 0 60px rgba(56, 189, 248, 0.25);
	}

	.glitch-glow {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		width: 260px;
		height: 120px;
		background: radial-gradient(circle, rgba(56, 189, 248, 0.25) 0%, rgba(99, 102, 241, 0.15) 50%, transparent 70%);
		filter: blur(40px);
		z-index: -1;
		pointer-events: none;
	}

	.hero-heading {
		font-family: "Plus Jakarta Sans", sans-serif;
		font-size: clamp(1.6rem, 3.5vw, 2.25rem);
		font-weight: 700;
		color: #ffffff;
		margin: 0.75rem 0;
		letter-spacing: -0.02em;
	}

	.gradient-text {
		background: linear-gradient(135deg, #38bdf8, #818cf8);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-lead {
		font-size: 1.1rem;
		color: var(--text-secondary);
		max-width: 580px;
		margin: 0 auto;
		line-height: 1.6;
	}

	/* Terminal Diagnostic Card */
	.terminal-card {
		background: rgba(11, 15, 25, 0.85);
		border: 1px solid rgba(56, 189, 248, 0.2);
		border-radius: 12px;
		overflow: hidden;
		text-align: left;
		margin: 0 auto 2.5rem;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
		backdrop-filter: blur(14px);
	}

	.terminal-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.65rem 1rem;
		background: rgba(18, 24, 38, 0.95);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.terminal-buttons {
		display: flex;
		gap: 6px;
	}

	.t-btn {
		width: 11px;
		height: 11px;
		border-radius: 50%;
	}

	.t-close { background: #ef4444; }
	.t-min { background: #f59e0b; }
	.t-max { background: #10b981; }

	.terminal-title {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.78rem;
		color: #94a3b8;
	}

	.terminal-empty { width: 40px; }

	.terminal-body {
		padding: 1.25rem;
		font-family: "JetBrains Mono", monospace;
		font-size: 0.88rem;
		line-height: 1.7;
	}

	.t-line {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: #f1f5f9;
		margin-bottom: 0.75rem;
		word-break: break-all;
	}

	.t-prompt {
		color: #10b981;
		font-weight: 700;
	}

	.t-cmd {
		color: #e2e8f0;
	}

	.t-response {
		color: #cbd5e1;
		font-size: 0.82rem;
		padding-left: 1rem;
		border-left: 2px solid rgba(56, 189, 248, 0.3);
	}

	.t-response p {
		margin: 0.25rem 0;
	}

	.t-cyan { color: #38bdf8; font-weight: 600; }
	.t-red { color: #ef4444; font-weight: 600; }
	.t-muted { color: #64748b; }

	/* Search Recovery Box */
	.search-recovery-box {
		max-width: 600px;
		margin: 0 auto 3rem;
	}

	.recovery-search-form {
		display: flex;
		align-items: center;
		background: rgba(15, 23, 42, 0.85);
		border: 1px solid rgba(56, 189, 248, 0.25);
		border-radius: 12px;
		padding: 0.4rem 0.5rem 0.4rem 1rem;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
		transition: all 0.2s ease;
	}

	.recovery-search-form:focus-within {
		border-color: #38bdf8;
		box-shadow: 0 0 20px rgba(56, 189, 248, 0.25);
	}

	.search-icon {
		color: #94a3b8;
		margin-right: 0.75rem;
		flex-shrink: 0;
	}

	.recovery-search-input {
		flex: 1;
		background: transparent;
		border: none;
		outline: none;
		color: #ffffff;
		font-size: 0.95rem;
		font-family: inherit;
	}

	.recovery-search-input::placeholder {
		color: #64748b;
	}

	.recovery-search-btn {
		padding: 0.6rem 1.25rem;
		font-size: 0.88rem;
		border-radius: 8px;
		white-space: nowrap;
	}

	/* Quick Nav Section */
	.quick-nav-section {
		margin-bottom: 3rem;
	}

	.quick-nav-title {
		font-family: "Plus Jakarta Sans", sans-serif;
		font-size: 1.15rem;
		font-weight: 600;
		color: #e2e8f0;
		margin-bottom: 1.25rem;
		text-align: left;
	}

	.quick-nav-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 1rem;
		text-align: left;
	}

	.quick-card {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 1.1rem;
		background: rgba(15, 23, 42, 0.6);
		border: 1px solid rgba(255, 255, 255, 0.07);
		border-radius: 12px;
		text-decoration: none;
		transition: all 0.25s ease;
	}

	.quick-card:hover {
		background: rgba(30, 41, 59, 0.8);
		border-color: rgba(56, 189, 248, 0.4);
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35);
	}

	.card-icon {
		font-size: 1.6rem;
		flex-shrink: 0;
	}

	.card-text {
		flex: 1;
		min-width: 0;
	}

	.card-text h4 {
		margin: 0 0 0.2rem 0;
		font-size: 0.95rem;
		font-weight: 600;
		color: #ffffff;
	}

	.card-text p {
		margin: 0;
		font-size: 0.8rem;
		color: #94a3b8;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.card-arrow {
		color: #64748b;
		font-size: 1.1rem;
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.quick-card:hover .card-arrow {
		color: #38bdf8;
		transform: translateX(4px);
	}

	/* Return Action */
	.return-action {
		display: flex;
		justify-content: center;
	}

	.back-home-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1.6rem;
		font-size: 0.95rem;
	}

	@media (max-width: 640px) {
		.not-found-main {
			padding: 2.5rem 1rem;
		}

		.quick-nav-grid {
			grid-template-columns: 1fr;
		}

		.recovery-search-form {
			flex-direction: column;
			gap: 0.75rem;
			padding: 0.85rem;
		}

		.recovery-search-btn {
			width: 100%;
			justify-content: center;
		}
	}
</style>
