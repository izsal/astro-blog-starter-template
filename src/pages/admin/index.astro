---
import BaseHead from '../../components/BaseHead.astro';
import { SITE_TITLE } from '../../consts';
import { verifyAdminSession } from '../../lib/admin-auth';

export const prerender = false;

const cookie = Astro.request.headers.get('cookie');
if (verifyAdminSession(cookie, Astro.locals.runtime?.env)) {
	return Astro.redirect('/admin/dashboard');
}
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead
			title={`Admin Login — ${SITE_TITLE}`}
			description="Autentikasi admin Content Command Center qblog."
		/>
	</head>
	<body class="admin-body">
		<main class="login-wrapper">
			<div class="glass-card login-card">
				<div class="login-header">
					<div class="brand-badge">
						<span class="dot"></span>
						<span class="brand-text">qblog</span>
					</div>
					<h1 class="login-title">Content Command Center</h1>
					<p class="login-subtitle">Masuk untuk mengelola artikel, SEO, dan database D1.</p>
				</div>

				<form id="admin-login-form" class="login-form">
					<div class="form-group">
						<label for="admin-token">Admin Secret Token</label>
						<input
							type="password"
							id="admin-token"
							placeholder="Masukkan token akses admin..."
							required
							autofocus
							class="token-input"
						/>
						<span class="hint-text">Default dev token: <code>qwarts-admin-2026</code></span>
					</div>

					<button type="submit" class="btn btn-primary login-btn" id="login-btn">
						Masuk ke Dashboard &rarr;
					</button>

					<p id="error-message" class="error-text"></p>
				</form>

				<div class="login-footer">
					<a href="/">&larr; Kembali ke Website Publik</a>
				</div>
			</div>
		</main>

		<script>
			const form = document.getElementById('admin-login-form') as HTMLFormElement | null;
			const tokenInput = document.getElementById('admin-token') as HTMLInputElement | null;
			const errEl = document.getElementById('error-message');
			const btn = document.getElementById('login-btn') as HTMLButtonElement | null;

			if (form && tokenInput && errEl && btn) {
				form.addEventListener('submit', async (e) => {
					e.preventDefault();
					const token = tokenInput.value.trim();
					if (!token) return;

					btn.disabled = true;
					errEl.textContent = 'Memverifikasi kredensial...';

					try {
						const res = await fetch('/admin/api/login', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ token }),
						});

						const data = await res.json();
						if (res.ok && data.success) {
							window.location.href = '/admin/dashboard';
						} else {
							errEl.textContent = data.message || 'Token tidak valid.';
							btn.disabled = false;
						}
					} catch (err) {
						errEl.textContent = 'Gagal terhubung ke server.';
						btn.disabled = false;
					}
				});
			}
		</script>
	</body>
</html>

<style>
	.admin-body {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background: #080b12;
		padding: 1.5rem;
	}

	.login-wrapper {
		width: 100%;
		max-width: 440px;
	}

	.login-card {
		padding: 2.5rem 2rem;
		border: 1px solid var(--border-highlight);
	}

	.login-header {
		text-align: center;
		margin-bottom: 2rem;
	}

	.brand-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.75rem;
		background: rgba(99, 102, 241, 0.15);
		border: 1px solid rgba(99, 102, 241, 0.3);
		border-radius: var(--radius-full);
		font-size: 0.82rem;
		margin-bottom: 1rem;
	}

	.dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #10b981;
	}

	.brand-text {
		font-weight: 700;
		color: #ffffff;
	}

	.login-title {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
	}

	.login-subtitle {
		font-size: 0.9rem;
		color: var(--text-secondary);
		line-height: 1.5;
	}

	.login-form {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.form-group label {
		font-size: 0.85rem;
		color: var(--text-primary);
		font-weight: 600;
	}

	.token-input {
		padding: 0.85rem 1rem;
		border-radius: var(--radius-sm);
		background: #0d121f;
		border: 1px solid var(--border-subtle);
		color: #ffffff;
		font-size: 0.95rem;
		outline: none;
	}

	.token-input:focus {
		border-color: var(--primary);
		box-shadow: 0 0 15px rgba(99, 102, 241, 0.3);
	}

	.hint-text {
		font-size: 0.78rem;
		color: var(--text-muted);
	}

	.hint-text code {
		color: var(--primary-light);
	}

	.login-btn {
		width: 100%;
		padding: 0.85rem;
	}

	.error-text {
		font-size: 0.85rem;
		color: #f87171;
		min-height: 1.2rem;
		text-align: center;
		margin: 0;
	}

	.login-footer {
		text-align: center;
		margin-top: 1.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border-subtle);
		font-size: 0.85rem;
	}

	.login-footer a {
		color: var(--text-muted);
	}

	.login-footer a:hover {
		color: var(--primary-light);
	}
</style>
