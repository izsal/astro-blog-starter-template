---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getD1Database } from '../../lib/db';
import { getCategoryBySlug, getCategories } from '../../lib/categories';
import { getUnifiedPosts } from '../../lib/posts';

export async function getStaticPaths() {
	return [
		{ params: { slug: 'development' } },
		{ params: { slug: 'frontend' } },
		{ params: { slug: 'backend' } },
		{ params: { slug: 'devops' } },
		{ params: { slug: 'cloud' } },
	];
}

const { slug } = Astro.params;
const db = getD1Database(Astro.locals);
const category = await getCategoryBySlug(db, slug || '');
const allPosts = await getUnifiedPosts(db);
const filteredPosts = allPosts.filter(
	(p) => (p.category || '').toLowerCase() === (category?.name || slug || '').toLowerCase()
);
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead
			title={`${category?.name || 'Category'} — ${SITE_TITLE}`}
			description={category?.description || `Koleksi artikel dalam kategori ${category?.name}.`}
		/>
	</head>
	<body>
		<Header />

		<main class="section">
			<div class="container">
				<div class="category-header">
					<div class="breadcrumb">
						<a href="/">Home</a> / <a href="/blog">Blog</a> / <span>Category</span>
					</div>
					<span class="pill pill-cyan mb-2">Category Cluster</span>
					<h1 class="page-title">{category?.name || slug}</h1>
					<p class="page-lead">{category?.description || 'Koleksi artikel teknis terstruktur.'}</p>
				</div>

				<div class="grid-2 posts-grid">
					{filteredPosts.length === 0 ? (
						<div class="empty-box glass-card">
							<p>Belum ada artikel yang dipublikasikan dalam kategori ini.</p>
							<a href="/blog" class="btn btn-primary">Lihat Semua Artikel &rarr;</a>
						</div>
					) : (
						filteredPosts.map((post) => (
							<a href={`/blog/${post.slug}/`} class="post-card">
								<div class="post-card-meta">
									<span>{new Date(post.published_at).toLocaleDateString('id-ID')}</span>
									<span>•</span>
									<span class="reading-time">{post.reading_time} min read</span>
								</div>
								<h3 class="post-card-title">{post.title}</h3>
								<p class="post-card-desc">{post.excerpt}</p>
								<div class="post-card-footer">
									<span class="read-more">Baca Artikel &rarr;</span>
									<span class="pill pill-neutral">{post.category}</span>
								</div>
							</a>
						))
					)}
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.category-header {
		margin-bottom: 3rem;
		max-width: 750px;
	}

	.breadcrumb {
		font-size: 0.85rem;
		color: var(--text-muted);
		margin-bottom: 1rem;
	}

	.breadcrumb a {
		color: var(--text-secondary);
	}

	.breadcrumb span {
		color: var(--primary-light);
	}

	.page-title {
		margin-bottom: 0.75rem;
	}

	.page-lead {
		font-size: 1.15rem;
		color: var(--text-secondary);
		line-height: 1.7;
	}

	.posts-grid {
		margin-bottom: 4rem;
	}

	.empty-box {
		grid-column: 1 / -1;
		text-align: center;
		padding: 3rem;
	}
</style>
