---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, AUTHOR_NAME } from '../consts';
import { getD1Database, getProjects } from '../lib/db';

const db = getD1Database(Astro.locals);
const projects = await getProjects(db, false);
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead
			title={`Projects & Portfolio — ${AUTHOR_NAME}`}
			description="Katalog sistem, tools open source, dan implementasi arsitektur cloud oleh qwarts."
		/>
	</head>
	<body>
		<Header />

		<main class="section">
			<div class="container">
				<div class="page-header">
					<div class="header-badges">
						<span class="pill pill-cyan">Live D1 Database (my-binding)</span>
						<span class="pill pill-emerald">Production & Homelab</span>
					</div>
					<h1 class="page-title">Projects & Architecture Portfolio</h1>
					<p class="page-lead">
						Kumpulan proyek pilihan yang mendemonstrasikan keahlian dalam perancangan sistem terdistribusi, microservices, frontend modern, dan edge infrastructure.
					</p>
				</div>

				<div class="grid-3 projects-grid">
					{projects.map((proj) => (
						<div class="project-card">
							<div class="project-header">
								<span class="pill pill-emerald">{proj.category}</span>
								<div class="project-links">
									{proj.github_url && (
										<a
											href={proj.github_url}
											target="_blank"
											rel="noopener"
											class="project-link-icon"
											title="View Source on GitHub"
										>
											<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
											</svg>
										</a>
									)}
									{proj.live_url && (
										<a
											href={proj.live_url}
											target="_blank"
											rel="noopener"
											class="project-link-icon"
											title="View Live Demo"
										>
											<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
												<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
												<polyline points="15 3 21 3 21 9"></polyline>
												<line x1="10" y1="14" x2="21" y2="3"></line>
											</svg>
										</a>
									)}
								</div>
							</div>

							<h3 class="project-title">{proj.title}</h3>
							<p class="project-desc">{proj.description}</p>

							<div class="project-stack">
								{proj.tech_stack.map((tech) => (
									<span class="pill pill-neutral">{tech}</span>
								))}
							</div>
						</div>
					))}
				</div>

				<div class="cta-box glass-card">
					<h3>Tertarik Membangun Sesuatu Bersama?</h3>
					<p>Saya terbuka untuk diskusi arsitektur, freelance projects, dan kolaborasi teknis.</p>
					<a href="/about" class="btn btn-primary">Hubungi / Tentang Saya &rarr;</a>
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.page-header {
		margin-bottom: 3.5rem;
		max-width: 750px;
	}

	.header-badges {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 1rem;
		flex-wrap: wrap;
	}

	.page-title {
		margin-bottom: 1rem;
	}

	.page-lead {
		font-size: 1.15rem;
		color: var(--text-secondary);
		line-height: 1.7;
	}

	.projects-grid {
		margin-bottom: 4rem;
	}

	.cta-box {
		text-align: center;
		padding: 3rem 2rem;
		max-width: 650px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}
</style>
