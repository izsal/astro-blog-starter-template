---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { AUTHOR_NAME, SITE_TITLE } from '../consts';
import { getD1Database } from '../lib/db';

const db = getD1Database(Astro.locals);

let devlogs: any[] = [];
if (db) {
	try {
		const { results } = await db.prepare("SELECT * FROM devlogs ORDER BY entry_date DESC").all();
		devlogs = results || [];
	} catch (e) {
		console.warn("Could not query devlogs:", e);
	}
}

if (devlogs.length === 0) {
	devlogs = [
		{
			id: "devlog-1",
			entry_date: "2026-09-15",
			title: "Membangun Content Intelligence & D1 SQLite Database",
			content: "Hari ini menyelesaikan skema relasional Cloudflare D1 untuk artikel, kategori, tags, dan content series. Mengintegrasikan Content Command Center agar blog memiliki kecerdasan SEO mandiri.",
			tags: JSON.stringify(["Cloudflare D1", "Astro 5", "Architecture"]),
		},
		{
			id: "devlog-2",
			entry_date: "2026-09-12",
			title: "Optimasi Cold Start dan Edge Caching di Cloudflare Workers",
			content: "Mengevaluasi latensi edge serverless. Menggunakan sub-request caching dan merestrukturisasi database queries menggunakan batch D1 API untuk performa sub-50ms.",
			tags: JSON.stringify(["Edge Computing", "Performance", "Cloudflare"]),
		},
		{
			id: "devlog-3",
			entry_date: "2026-09-08",
			title: "Setup Homelab Traefik Reverse Proxy & Automated SSL",
			content: "Mengonfigurasi Traefik v3 dengan Docker provider. Otomasi sertifikat Let's Encrypt via DNS challenge Cloudflare untuk seluruh domain internal homelab.",
			tags: JSON.stringify(["Docker", "Traefik", "Homelab"]),
		},
	];
}
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead
			title={`Developer Journal & Devlog — ${AUTHOR_NAME}`}
			description="Catatan harian proses software engineering, eksperimen sistem, dan pencapaian pengembangan harian."
		/>
	</head>
	<body>
		<Header />

		<main class="section">
			<div class="container devlog-container">
				<div class="page-header">
					<div class="header-badges">
						<span class="pill pill-cyan">Behind the Scenes</span>
						<span class="pill pill-emerald">D1 Live Stream</span>
					</div>
					<h1 class="page-title">Developer Journal & Devlog</h1>
					<p class="page-lead">
						Berbeda dengan artikel tutorial formal di blog, <strong>/devlog</strong> adalah jurnal transparan tentang proses rekayasa sehari-hari: apa yang sedang saya pecahkan, bug yang membingungkan, dan keputusan arsitektur sistem.
					</p>
				</div>

				<div class="devlog-timeline">
					{devlogs.map((entry) => {
						const tagList: string[] = typeof entry.tags === 'string' ? JSON.parse(entry.tags) : (entry.tags || []);
						return (
							<article class="devlog-card glass-card">
								<div class="devlog-meta">
									<time class="devlog-date">{new Date(entry.entry_date).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
									<span class="pill pill-neutral">Engineering Log</span>
								</div>

								<h2 class="devlog-title">{entry.title}</h2>
								<p class="devlog-body">{entry.content}</p>

								<div class="devlog-tags">
									{tagList.map((tag: string) => (
										<span class="pill pill-cyan">#{tag}</span>
									))}
								</div>
							</article>
						);
					})}
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.devlog-container {
		max-width: 780px;
	}

	.page-header {
		margin-bottom: 3.5rem;
	}

	.header-badges {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 1rem;
	}

	.page-title {
		margin-bottom: 0.75rem;
	}

	.page-lead {
		font-size: 1.15rem;
		color: var(--text-secondary);
		line-height: 1.7;
	}

	.devlog-timeline {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		margin-bottom: 4rem;
	}

	.devlog-card {
		padding: 2rem;
		border-left: 4px solid var(--primary);
	}

	.devlog-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.devlog-date {
		font-family: "JetBrains Mono", monospace;
		font-size: 0.85rem;
		color: var(--primary-light);
		font-weight: 600;
	}

	.devlog-title {
		font-size: 1.35rem;
		color: #ffffff;
		margin-bottom: 0.75rem;
		line-height: 1.3;
	}

	.devlog-body {
		font-size: 0.98rem;
		color: var(--text-secondary);
		line-height: 1.7;
		margin-bottom: 1.25rem;
	}

	.devlog-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		padding-top: 1rem;
		border-top: 1px solid var(--border-subtle);
	}
</style>
