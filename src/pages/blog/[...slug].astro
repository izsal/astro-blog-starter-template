---
import { getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { getD1Database } from "../../lib/db";
import { marked } from "marked";

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
	return Astro.redirect("/404");
}

const db = getD1Database(Astro.locals);
let d1Post: any = null;

if (db) {
	try {
		d1Post = await db
			.prepare(
				"SELECT * FROM posts WHERE (slug = ? OR id = ?) AND (is_trashed = 0 OR is_trashed IS NULL)",
			)
			.bind(slug, slug)
			.first();
	} catch (e) {
		console.warn("Could not query post by slug from D1:", e);
	}
}

let StaticContent: any = null;
let postData: any = null;
let htmlContent = "";

if (d1Post) {
	postData = {
		title: d1Post.title,
		description: d1Post.excerpt || d1Post.title,
		pubDate: d1Post.published_at
			? new Date(d1Post.published_at)
			: new Date(),
		updatedDate: d1Post.updated_at
			? new Date(d1Post.updated_at)
			: undefined,
		heroImage: d1Post.cover_image || "/blog-placeholder-1.jpg",
		slug: d1Post.slug || slug,
	};
	htmlContent = await marked.parse(d1Post.content || "");
} else {
	const staticPosts = await getCollection("blog");
	const staticPost = staticPosts.find((p) => p.id === slug);

	if (staticPost) {
		const rendered = await render(staticPost);
		StaticContent = rendered.Content;
		postData = {
			title: staticPost.data.title,
			description: staticPost.data.description,
			pubDate: staticPost.data.pubDate,
			updatedDate: staticPost.data.updatedDate,
			heroImage: staticPost.data.heroImage,
			slug: staticPost.id,
		};
	} else {
		return Astro.redirect("/404");
	}
}
---

<BlogPost {...postData}>
	{
		StaticContent ? (
			<StaticContent />
		) : (
			<div class="rendered-markdown-content" set:html={htmlContent} />
		)
	}
</BlogPost>
