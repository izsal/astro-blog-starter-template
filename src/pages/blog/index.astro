---
export const prerender = false;

import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, TECH_CLUSTERS } from '../../consts';
import { getD1Database } from '../../lib/db';
import { getUnifiedPosts } from '../../lib/posts';
import FormattedDate from '../../components/FormattedDate.astro';

const db = getD1Database(Astro.locals);
const tagFilter = Astro.url.searchParams.get('tag');

let allPosts = await getUnifiedPosts(db, { status: 'PUBLISHED' });

if (tagFilter) {
	allPosts = allPosts.filter(
		(p) =>
			(p.tags && p.tags.some((t) => t.toLowerCase() === tagFilter.toLowerCase())) ||
			(p.category && p.category.toLowerCase() === tagFilter.toLowerCase())
	);
}
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead
			title={`Articles & Technical Guides — ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body>
		<Header />
		
		<main class="section">
			<div class="container">
				<div class="page-header">
					<span class="pill pill-cyan mb-2">Technical Knowledge Base</span>
					<h1 class="page-title">Articles, Tutorials & Architecture Guides</h1>
					<p class="page-lead">
						Dokumentasi komprehensif seputar arsitektur cloud edge, modern frontend, dev tooling, dan pembelajaran software engineering.
					</p>

					<!-- Content Clusters Filter -->
					<div class="clusters-bar">
						<span class="cluster-label">Topic Clusters:</span>
						<a href="/blog" class:list={['cluster-pill', { active: !tagFilter }]}>All Topics</a>
						{TECH_CLUSTERS.map((cluster) => (
							<a
								href={`/blog?tag=${encodeURIComponent(cluster)}`}
								class:list={['cluster-pill', { active: tagFilter?.toLowerCase() === cluster.toLowerCase() }]}
							>
								{cluster}
							</a>
						))}
					</div>
				</div>

				<div class="articles-grid">
					{allPosts.length === 0 ? (
						<div class="empty-state">
							<p>Belum ada artikel yang dipublikasikan dalam kategori ini.</p>
						</div>
					) : (
						allPosts.map((post, index) => (
							<article class:list={['blog-card-item', { 'featured-item': index === 0 }]}>
								<a href={`/blog/${post.slug}/`} class="blog-card-link">
									{post.cover_image && (
										<div class="card-image-wrap">
											<img
												src={post.cover_image}
												alt={post.title}
												loading={index === 0 ? 'eager' : 'lazy'}
												class="card-img"
											/>
										</div>
									)}
									<div class="card-content">
										<div class="card-meta">
											<FormattedDate date={new Date(post.published_at)} />
											<span class="dot-separator">•</span>
											<span class="tag-pill">{post.category || 'Guide'}</span>
										</div>
										<h2 class="card-title">{post.title}</h2>
										<p class="card-desc">{post.excerpt}</p>
										<div class="card-bottom">
											<span class="read-text">Baca Artikel &rarr;</span>
											<span class="edge-note">{post.reading_time || 3} min read</span>
										</div>
									</div>
								</a>
							</article>
						))
					)}
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.page-header {
		margin-bottom: 3rem;
		max-width: 800px;
	}

	.page-title {
		margin-bottom: 0.75rem;
	}

	.page-lead {
		font-size: 1.15rem;
		color: var(--text-secondary);
		line-height: 1.7;
		margin-bottom: 1.75rem;
	}

	.clusters-bar {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border-subtle);
	}

	.cluster-label {
		font-size: 0.85rem;
		color: var(--text-muted);
		font-weight: 600;
	}

	.cluster-pill {
		display: inline-flex;
		align-items: center;
		padding: 0.3rem 0.75rem;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid var(--border-subtle);
		border-radius: var(--radius-full);
		font-size: 0.8rem;
		color: var(--text-secondary);
		transition: var(--transition-smooth);
	}

	.cluster-pill:hover, .cluster-pill.active {
		background: rgba(99, 102, 241, 0.15);
		border-color: var(--border-highlight);
		color: #ffffff;
	}

	.articles-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 2rem;
		margin-bottom: 4rem;
	}

	.featured-item {
		grid-column: 1 / -1;
	}

	.featured-item .blog-card-link {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 2rem;
		align-items: center;
	}

	.blog-card-item {
		border-radius: var(--radius-md);
		background: var(--bg-card);
		border: 1px solid var(--border-subtle);
		overflow: hidden;
		transition: var(--transition-smooth);
	}

	.blog-card-item:hover {
		border-color: var(--border-highlight);
		box-shadow: var(--shadow-glow);
		transform: translateY(-3px);
	}

	.blog-card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
	}

	.card-image-wrap {
		width: 100%;
		max-height: 280px;
		overflow: hidden;
		background: #0d131f;
	}

	.card-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.35s ease;
	}

	.blog-card-item:hover .card-img {
		transform: scale(1.03);
	}

	.card-content {
		padding: 1.75rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.card-meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.82rem;
		color: var(--text-muted);
		margin-bottom: 0.75rem;
	}

	.tag-pill {
		color: var(--primary-light);
		font-weight: 600;
	}

	.card-title {
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.75rem;
		line-height: 1.35;
		transition: color 0.2s ease;
	}

	.blog-card-item:hover .card-title {
		color: var(--primary-light);
	}

	.card-desc {
		font-size: 0.95rem;
		color: var(--text-secondary);
		margin-bottom: 1.5rem;
		line-height: 1.6;
		flex: 1;
	}

	.card-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-top: 1rem;
		border-top: 1px solid var(--border-subtle);
		font-size: 0.85rem;
	}

	.read-text {
		color: var(--primary-light);
		font-weight: 600;
	}

	.edge-note {
		color: var(--text-muted);
		font-family: "JetBrains Mono", monospace;
		font-size: 0.78rem;
	}

	@media (max-width: 768px) {
		.featured-item .blog-card-link {
			grid-template-columns: 1fr;
		}
	}
</style>
