---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { AUTHOR_NAME, SITE_TITLE } from '../consts';

const bookmarks = [
	{
		category: 'Documentation',
		items: [
			{ title: 'Astro Official Documentation', url: 'https://docs.astro.build/', desc: 'Panduan lengkap dan API reference Astro 5.' },
			{ title: 'Cloudflare D1 Docs', url: 'https://developers.cloudflare.com/d1/', desc: 'Dokumentasi database serverless SQLite di Cloudflare.' },
			{ title: 'TypeScript Handbook', url: 'https://www.typescriptlang.org/docs/', desc: 'Referensi tipe data dan pola arsitektur TypeScript.' },
		],
	},
	{
		category: 'Tools & Utilities',
		items: [
			{ title: 'SQLite FTS5 Documentation', url: 'https://www.sqlite.org/fts5.html', desc: 'Full-text search engine terintegrasi dalam SQLite.' },
			{ title: 'Traefik Proxy', url: 'https://traefik.io/', desc: 'Modern HTTP reverse proxy dan load balancer untuk microservices.' },
			{ title: 'Hono Web Framework', url: 'https://hono.dev/', desc: 'Ultrafast web framework untuk edge computing dan Cloudflare Workers.' },
		],
	},
	{
		category: 'Articles & Inspiration',
		items: [
			{ title: 'Dan Luu: Velocity & Systems', url: 'https://danluu.com/', desc: 'Esai mendalam tentang arsitektur hardware, software, dan kecepatan rekayasa.' },
			{ title: 'Martin Fowler: Microservices Guide', url: 'https://martinfowler.com/articles/microservices.html', desc: 'Prinsip arsitektur arsitektural sistem modular terdistribusi.' },
		],
	},
	{
		category: 'Curated Repositories',
		items: [
			{ title: 'withastro/astro', url: 'https://github.com/withastro/astro', desc: 'Repositori open-source framework Astro.' },
			{ title: 'cloudflare/workers-sdk', url: 'https://github.com/cloudflare/workers-sdk', desc: 'Repositori CLI Wrangler dan Cloudflare Workers SDK.' },
		],
	},
];
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead
			title={`Bookmarks & Developer Resources — ${AUTHOR_NAME}`}
			description="Kurasi artikel favorit, dokumentasi resmi, tools pilihan, dan repositori open-source bermanfaat."
		/>
	</head>
	<body>
		<Header />

		<main class="section">
			<div class="container bookmarks-container">
				<div class="page-header">
					<span class="pill pill-cyan mb-2">Curated Links</span>
					<h1 class="page-title">Developer Bookmarks & Resources</h1>
					<p class="page-lead">
						Daftar referensi berkualitas tinggi, dokumentasi teknis, dan tools yang sering saya kunjungi dan rekomendasikan kepada sesama engineer.
					</p>
				</div>

				<div class="bookmarks-groups">
					{bookmarks.map((group) => (
						<section class="bookmark-group">
							<h2 class="group-title">{group.category}</h2>
							<div class="bookmark-list">
								{group.items.map((item) => (
									<a href={item.url} target="_blank" rel="noopener noreferrer" class="bookmark-item glass-card">
										<div class="item-content">
											<h3 class="item-title">{item.title}</h3>
											<p class="item-desc">{item.desc}</p>
										</div>
										<span class="external-icon">↗</span>
									</a>
								))}
							</div>
						</section>
					))}
				</div>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.bookmarks-container {
		max-width: 820px;
	}

	.page-header {
		margin-bottom: 3.5rem;
	}

	.page-title {
		margin-bottom: 0.75rem;
	}

	.page-lead {
		font-size: 1.15rem;
		color: var(--text-secondary);
		line-height: 1.7;
	}

	.bookmarks-groups {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		margin-bottom: 4rem;
	}

	.group-title {
		font-size: 1.35rem;
		margin-bottom: 1.25rem;
		color: #ffffff;
		border-left: 3px solid var(--primary);
		padding-left: 0.75rem;
	}

	.bookmark-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.bookmark-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.25rem 1.5rem;
		text-decoration: none;
		gap: 1.5rem;
	}

	.item-title {
		font-size: 1.1rem;
		color: #ffffff;
		margin-bottom: 0.35rem;
		transition: color 0.2s ease;
	}

	.bookmark-item:hover .item-title {
		color: var(--primary-light);
	}

	.item-desc {
		font-size: 0.9rem;
		color: var(--text-secondary);
		margin: 0;
	}

	.external-icon {
		font-size: 1.25rem;
		color: var(--text-muted);
		transition: var(--transition-smooth);
	}

	.bookmark-item:hover .external-icon {
		color: var(--primary-light);
		transform: translate(2px, -2px);
	}
</style>
