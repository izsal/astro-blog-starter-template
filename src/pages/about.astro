---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { AUTHOR_NAME, AUTHOR_ROLE, AUTHOR_BIO, SITE_TITLE, SOCIAL_LINKS, TECH_CLUSTERS } from '../consts';

const experiences = [
	{
		role: "Frontend Developer",
		company: "PT Multi Karya Solusi",
		period: "Sep 2024 — Sekarang",
		description:
			"Membangun ITOKIN Quality Control (QC) Mobile App dengan React Native, integrasi API real-time, Web App IRS Automated Social Media (AI & RPA), dan manajemen storage file dengan NextCloud.",
	},
	{
		role: "Fullstack Developer",
		company: "PT GUITEKNO TRESNA TELEKOMUNIKASI",
		period: "Sep 2023 — Sep 2024",
		description:
			"Mengembangkan platform video sharing LahTube (Web, Android, iOS, TV Box), implementasi high-performance infinite scroll, Admin Market interface, dan standardisasi Docker Compose.",
	},
	{
		role: "Backend Developer",
		company: "PT. Tekno Solusi Nusantara",
		period: "Sep 2023 — Des 2023",
		description:
			"Mengembangkan high-performance RESTful APIs dengan Golang, optimasi query MySQL/PostgreSQL (mengurangi latency hingga 30%), arsitektur microservices dengan gRPC, dan caching Redis.",
	},
	{
		role: "Fullstack Developer",
		company: "PT Visi Multimedia Aditama",
		period: "Mei 2022 — Agu 2023",
		description:
			"Merancang Admin Tool kustom untuk manajemen konten dan situs, RESTful API dengan Golang, serta perbaikan integritas data pada PostgreSQL.",
	},
	{
		role: "Backend Developer",
		company: "RUN System",
		period: "Mar 2021 — Mar 2022",
		description:
			"Mengembangkan aplikasi B2B Run Market dan solusi perkantoran digital E-Office, migrasi basis data, serta pemecahan masalah kritis sistem backend.",
	},
];

const technicalSkills = [
	{ category: "Frontend & Mobile", items: ["React.js", "React Native", "Next.js", "Vue.js", "Inertia.js", "Tailwind CSS", "TypeScript", "ApexCharts", "Mapbox"] },
	{ category: "Backend & Systems", items: ["Golang (Go)", "RESTful APIs", "gRPC", "Microservices", "PHP / Laravel", "CodeIgniter", "Node.js", "Go test"] },
	{ category: "Databases & Storage", items: ["PostgreSQL", "MySQL", "Cloudflare D1 (SQLite)", "Redis Caching", "NextCloud", "Query Optimization"] },
	{ category: "Cloud & DevOps", items: ["Docker & Compose", "Cloudflare Workers", "Cloudflare Pages", "Git (GitHub/GitLab)", "Linux (Ubuntu)", "Agile/Scrum"] },
];
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead
			title={`About ${AUTHOR_NAME} — ${SITE_TITLE}`}
			description={`Tentang ${AUTHOR_NAME}: ${AUTHOR_ROLE}. Pengalaman profesional, arsitektur teknis, dan portofolio Fullstack & Mobile.`}
		/>
	</head>
	<body>
		<Header />

		<main class="section">
			<div class="container about-container">
				<!-- Hero Bio -->
				<section class="bio-hero">
					<div class="bio-avatar-badge">
						<span class="avatar-initials">IA</span>
					</div>
					<div class="bio-content">
						<span class="pill pill-cyan mb-2">Fullstack & Mobile Developer</span>
						<h1 class="bio-title">Halo, saya <span class="gradient-text">{AUTHOR_NAME}</span></h1>
						<p class="bio-subtitle">{AUTHOR_ROLE}</p>
						<p class="bio-text">{AUTHOR_BIO}</p>

						<div class="social-links-row">
							<a href="/cv" class="btn btn-primary">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
									<polyline points="14 2 14 8 20 8"></polyline>
									<line x1="16" y1="13" x2="8" y2="13"></line>
									<line x1="16" y1="17" x2="8" y2="17"></line>
									<polyline points="10 9 9 9 8 9"></polyline>
								</svg>
								<span>Buka & Cetak CV Lengkap &rarr;</span>
							</a>
							<a href={SOCIAL_LINKS.linkedin} target="_blank" rel="noopener" class="btn btn-secondary">
								<span>LinkedIn ↗</span>
							</a>
							<a href={SOCIAL_LINKS.github} target="_blank" rel="noopener" class="btn btn-secondary">
								<span>GitHub ↗</span>
							</a>
							<a href={`mailto:${SOCIAL_LINKS.email}`} class="btn btn-secondary">
								<span>Email Me</span>
							</a>
						</div>
					</div>
				</section>

				<!-- Philosophy / Vision (PRD Section 1) -->
				<section class="philosophy-section glass-card">
					<h3>Filosofi & Core Vision</h3>
					<blockquote class="vision-quote">
						"Tempat untuk mendokumentasikan apa yang saya pelajari, apa yang saya bangun, dan membangun personal brand melalui tulisan."
					</blockquote>
					<p>
						Sebagai engineer dengan rekam jejak dalam pengembangan web dan mobile (React, React Native, Golang), saya mendedikasikan platform ini untuk berbagi wawasan arsitektural seputar sistem modular, optimasi query database, edge computing (Cloudflare D1/Workers), dan containerisasi Docker.
					</p>
				</section>

				<!-- Technical Skills Grid -->
				<section class="skills-section">
					<h2 class="section-title">Technical Skillset</h2>
					<p class="section-subtitle">Teknologi dan tools yang saya kuasai dalam production, enterprise applications, dan riset mandiri.</p>

					<div class="grid-2 skills-grid">
						{technicalSkills.map((cat) => (
							<div class="glass-card skill-cat-card">
								<h3 class="cat-name">{cat.category}</h3>
								<div class="skills-list">
									{cat.items.map((item) => (
										<span class="pill pill-neutral">{item}</span>
									))}
								</div>
							</div>
						))}
					</div>
				</section>

				<!-- Experience Timeline -->
				<section class="timeline-section">
					<h2 class="section-title">Pengalaman & Rekam Jejak Karir</h2>
					<div class="timeline">
						{experiences.map((exp) => (
							<div class="timeline-item">
								<div class="timeline-marker"></div>
								<div class="timeline-content glass-card">
									<div class="timeline-header">
										<h3 class="exp-role">{exp.role}</h3>
										<span class="exp-period pill pill-cyan">{exp.period}</span>
									</div>
									<h4 class="exp-company">{exp.company}</h4>
									<p class="exp-desc">{exp.description}</p>
								</div>
							</div>
						))}
					</div>
				</section>

				<!-- Call to Action -->
				<section class="contact-cta glass-card">
					<h2>Mari Terhubung</h2>
					<p>Punya pertanyaan teknis, tawaran kolaborasi, atau peluang kerja sama? Pintu komunikasi selalu terbuka.</p>
					<a href={`mailto:${SOCIAL_LINKS.email}`} class="btn btn-primary">
						Kirim Pesan ke {SOCIAL_LINKS.email} &rarr;
					</a>
				</section>
			</div>
		</main>

		<Footer />
	</body>
</html>

<style>
	.about-container {
		max-width: 820px;
	}

	.bio-hero {
		display: flex;
		gap: 2.5rem;
		align-items: center;
		margin-bottom: 3.5rem;
	}

	.bio-avatar-badge {
		width: 120px;
		height: 120px;
		border-radius: var(--radius-lg);
		background: var(--primary-gradient);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		box-shadow: 0 10px 30px rgba(99, 102, 241, 0.4);
	}

	.avatar-initials {
		font-family: "Plus Jakarta Sans", sans-serif;
		font-weight: 800;
		font-size: 2.5rem;
		color: #ffffff;
	}

	.bio-title {
		font-size: clamp(2rem, 4vw, 2.7rem);
		margin-bottom: 0.25rem;
	}

	.bio-subtitle {
		font-size: 1.15rem;
		color: var(--primary-light);
		font-weight: 600;
		margin-bottom: 1rem;
	}

	.bio-text {
		font-size: 1.05rem;
		color: var(--text-secondary);
		line-height: 1.65;
		margin-bottom: 1.5rem;
	}

	.social-links-row {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.mb-2 {
		margin-bottom: 0.5rem;
	}

	.philosophy-section {
		margin-bottom: 3.5rem;
		padding: 2.5rem;
		border-left: 4px solid var(--primary);
	}

	.vision-quote {
		font-size: 1.15rem;
		font-style: italic;
		color: #c7d2fe;
		margin: 1rem 0 1.25rem;
		line-height: 1.6;
	}

	.skills-section {
		margin-bottom: 3.5rem;
	}

	.skills-grid {
		margin-top: 1.5rem;
	}

	.skill-cat-card {
		padding: 1.5rem;
	}

	.cat-name {
		font-size: 1.1rem;
		color: #ffffff;
		margin-bottom: 1rem;
	}

	.skills-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.timeline-section {
		margin-bottom: 3.5rem;
	}

	.timeline {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin-top: 1.5rem;
		border-left: 2px solid var(--border-subtle);
		padding-left: 1.5rem;
		position: relative;
	}

	.timeline-item {
		position: relative;
	}

	.timeline-marker {
		position: absolute;
		left: -1.95rem;
		top: 1.5rem;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--primary);
		box-shadow: 0 0 10px var(--primary);
	}

	.timeline-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 0.35rem;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.exp-role {
		font-size: 1.15rem;
		color: #ffffff;
	}

	.exp-company {
		font-size: 0.95rem;
		color: var(--primary-light);
		margin-bottom: 0.75rem;
		font-weight: 500;
	}

	.exp-desc {
		font-size: 0.92rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin: 0;
	}

	.contact-cta {
		text-align: center;
		padding: 3rem 2rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	@media (max-width: 680px) {
		.bio-hero {
			flex-direction: column;
			text-align: center;
		}

		.social-links-row {
			justify-content: center;
		}
	}
</style>
